<div class="terrain-stage absolute inset-0 z-0 pointer-events-none" data-terrain-stage aria-hidden="true">
  <div class="terrain-halo"></div>
  <div class="terrain-canvas" data-terrain-canvas></div>
</div>

<script>
  import * as THREE from 'three';

  // An open, folded landscape: a sharp ridgeline rising out of a fine triangular mesh.
  // Surface, edges, and survey points share the same GPU displacement.
  const terrainVertex = `
    uniform float uTime;
    varying float vHeight;
    varying float vFade;
    varying float vSignal;
    void main() {
      vec3 p = position;
      float breath = sin(p.x * 0.7 + p.z * 0.65 + uTime * 0.42);
      p.y += breath * 0.09 + sin(p.z * 1.1 - uTime * 0.3) * 0.045;
      vHeight = clamp((position.y + 1.2) / 3.7, 0.0, 1.0);
      vFade = (1.0 - smoothstep(4.8, 7.8, abs(p.x)))
        * (1.0 - smoothstep(2.6, 3.9, abs(p.z)));
      // A narrow signal sweeps across the mesh without adding geometry each frame.
      float phase = fract(p.x * 0.065 - uTime * 0.055);
      vSignal = pow(max(0.0, 1.0 - abs(phase - 0.5) * 18.0), 3.0);
      vec4 viewPosition = modelViewMatrix * vec4(p, 1.0);
      gl_Position = projectionMatrix * viewPosition;
      gl_PointSize = min(3.0, 15.0 / max(1.0, -viewPosition.z));
    }
  `;

  function mountTerrain(stage: HTMLElement) {
    const container = stage.querySelector<HTMLElement>('[data-terrain-canvas]');
    if (!container || container.childElementCount) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'low-power' });
    } catch {
      // The CSS halo remains when WebGL is unavailable.
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setClearColor(0x09090b, 0);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(39, 1, 0.1, 40);
    camera.position.set(0, 3.8, 12.5);
    camera.lookAt(0, 0.2, 0);

    const sculpture = new THREE.Group();
    scene.add(sculpture);
    const columns = window.innerWidth < 768 ? 56 : 88;
    const rows = window.innerWidth < 768 ? 26 : 40;
    const positions: number[] = [];
    const indices: number[] = [];
    const edges: number[] = [];
    const surveyPoints: number[] = [];
    const uniforms = { uTime: { value: 0 } };

    function heightAt(x: number, z: number) {
      const spine = -0.9 + Math.sin(x * 0.53) * 0.7;
      const crest = Math.exp(-Math.pow((z - spine) / 0.95, 2));
      const rise = 2.4 + 1.7 * Math.exp(-Math.pow((x - 0.4) / 2.8, 2));
      const foothill = 0.85 * Math.exp(-Math.pow((z - 1.65) / 0.65, 2))
        * Math.exp(-Math.pow((x + 3.3) / 3.4, 2));
      return -1.45 + crest * rise + foothill
        + Math.sin(x * 0.8 + z * 0.6) * 0.14
        + Math.sin(x * 1.6 - z * 0.9) * 0.08;
    }

    for (let row = 0; row <= rows; row++) {
      for (let col = 0; col <= columns; col++) {
        // Staggered rows create an architectural triangular lattice.
        const x = (col / columns - 0.5) * 16 + (row % 2) * 8 / columns;
        const z = (row / rows - 0.5) * 7.8;
        const y = heightAt(x, z);
        positions.push(x, y, z);
        if (col % 4 === 0 && row % 3 === 0) surveyPoints.push(x, y, z);
        if (row < rows && col < columns) {
          const a = row * (columns + 1) + col;
          const b = a + 1;
          const c = a + columns + 1;
          const d = c + 1;
          if (row % 2) {
            indices.push(a, c, b, b, c, d);
            edges.push(a, b, a, c, b, c);
          } else {
            indices.push(a, c, d, a, d, b);
            edges.push(a, b, a, c, a, d);
          }
        }
      }
    }

    const positionAttribute = new THREE.Float32BufferAttribute(positions, 3);
    const surfaceGeometry = new THREE.BufferGeometry();
    surfaceGeometry.setAttribute('position', positionAttribute);
    surfaceGeometry.setIndex(indices);
    const surfaceMaterial = new THREE.ShaderMaterial({
      uniforms, vertexShader: terrainVertex,
      fragmentShader: `
        varying float vHeight;
        varying float vFade;
        void main() {
          vec3 shade = mix(vec3(0.018, 0.019, 0.025), vec3(0.065, 0.033, 0.022), vHeight);
          gl_FragColor = vec4(shade, vFade * 0.92);
        }
      `,
      side: THREE.DoubleSide, transparent: true,
      polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1,
    });
    sculpture.add(new THREE.Mesh(surfaceGeometry, surfaceMaterial));

    const edgeGeometry = new THREE.BufferGeometry();
    edgeGeometry.setAttribute('position', positionAttribute);
    edgeGeometry.setIndex(edges);
    const edgeMaterial = new THREE.ShaderMaterial({
      uniforms, vertexShader: terrainVertex,
      fragmentShader: `
        varying float vHeight;
        varying float vFade;
        varying float vSignal;
        void main() {
          vec3 color = mix(vec3(0.48, 0.16, 0.055), vec3(1.0, 0.49, 0.19), vHeight);
          color = mix(color, vec3(1.0, 0.72, 0.38), vSignal * 0.65);
          float opacity = (0.2 + vHeight * 0.65 + vSignal * 0.2) * vFade;
          gl_FragColor = vec4(color, opacity);
        }
      `,
      transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
    });
    const wireframe = new THREE.LineSegments(edgeGeometry, edgeMaterial);
    wireframe.renderOrder = 1;
    sculpture.add(wireframe);

    const pointGeometry = new THREE.BufferGeometry();
    pointGeometry.setAttribute('position', new THREE.Float32BufferAttribute(surveyPoints, 3));
    const pointMaterial = new THREE.ShaderMaterial({
      uniforms, vertexShader: terrainVertex,
      fragmentShader: `
        varying float vHeight;
        varying float vFade;
        varying float vSignal;
        void main() {
          float radius = length(gl_PointCoord - 0.5);
          float dot = 1.0 - smoothstep(0.15, 0.5, radius);
          gl_FragColor = vec4(1.0, 0.65, 0.32, dot * vFade * (0.25 + vHeight * 0.4 + vSignal * 0.35));
        }
      `,
      transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
    });
    const points = new THREE.Points(pointGeometry, pointMaterial);
    points.renderOrder = 2;
    sculpture.add(points);

    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = new THREE.Vector2();
    const smoothedPointer = new THREE.Vector2();
    let frame = 0;
    let visible = false;
    let disposed = false;
    let elapsed = 0;
    let previousTime = 0;

    function render(time: number) {
      frame = 0;
      if (disposed) return;
      const delta = previousTime ? Math.min((time - previousTime) / 1000, 0.05) : 0;
      previousTime = time;
      if (!motion.matches) elapsed += delta;
      if (motion.matches) smoothedPointer.set(0, 0);
      else smoothedPointer.lerp(pointer, 0.035);
      uniforms.uTime.value = elapsed;
      sculpture.rotation.set(
        -0.08 + smoothedPointer.y * 0.035,
        -0.16 + smoothedPointer.x * 0.065,
        0.065,
      );
      renderer.render(scene, camera);
      if (visible && !document.hidden && !motion.matches) frame = requestAnimationFrame(render);
    }

    function requestRender() {
      if (!frame && !disposed && visible && !document.hidden) {
        previousTime = 0;
        frame = requestAnimationFrame(render);
      }
    }

    function resize() {
      const { width, height } = container.getBoundingClientRect();
      if (!width || !height) return;
      renderer.setSize(width, height);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      const mobile = width < 768;
      sculpture.scale.setScalar(mobile ? 0.65 : 1.0);
      sculpture.position.set(mobile ? -0.6 : 0, mobile ? 0.8 : -0.55, 0);
      requestRender();
    }

    function onPointer(event: PointerEvent) {
      const rect = stage.getBoundingClientRect();
      pointer.set(
        THREE.MathUtils.clamp((event.clientX - rect.left) / rect.width * 2 - 1, -1, 1),
        THREE.MathUtils.clamp((event.clientY - rect.top) / rect.height * 2 - 1, -1, 1),
      );
    }

    function updatePlayback() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      requestRender();
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(container);
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updatePlayback();
    });
    intersectionObserver.observe(stage);
    window.addEventListener('pointermove', onPointer, { passive: true });
    document.addEventListener('visibilitychange', updatePlayback);
    motion.addEventListener('change', updatePlayback);
    resize();

    function dispose() {
      disposed = true;
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      window.removeEventListener('pointermove', onPointer);
      document.removeEventListener('visibilitychange', updatePlayback);
      motion.removeEventListener('change', updatePlayback);
      document.removeEventListener('astro:before-swap', dispose);
      window.removeEventListener('pagehide', onPageHide);
      window.removeEventListener('pageshow', updatePlayback);
      surfaceGeometry.dispose();
      surfaceMaterial.dispose();
      edgeGeometry.dispose();
      edgeMaterial.dispose();
      pointGeometry.dispose();
      pointMaterial.dispose();
      renderer.dispose();
      renderer.domElement.remove();
    }
    function onPageHide(event: PageTransitionEvent) {
      if (!event.persisted) dispose();
    }
    document.addEventListener('astro:before-swap', dispose, { once: true });
    window.addEventListener('pagehide', onPageHide);
    window.addEventListener('pageshow', updatePlayback);
  }

  function initTerrain() {
    document.querySelectorAll<HTMLElement>('[data-terrain-stage]').forEach(mountTerrain);
  }
  initTerrain();
  document.addEventListener('astro:page-load', initTerrain);
</script>

<style>
  .terrain-stage {
    overflow: hidden;
    contain: layout paint;
  }
  .terrain-halo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 55% 54%, rgb(234 88 12 / 0.08), transparent 53%),
      radial-gradient(ellipse at 46% 43%, rgb(148 163 184 / 0.035), transparent 48%);
  }
  .terrain-canvas {
    position: absolute;
    inset: 0;
    opacity: 1;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 84%, transparent);
  }
  .terrain-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 767px) {
    .terrain-canvas { opacity: 0.85; }
  }
</style>
