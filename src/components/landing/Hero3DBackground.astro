<div class="orbital-stage absolute inset-0 z-0 pointer-events-none" data-orbital-stage aria-hidden="true">
  <div class="orbital-halo"></div>
  <div class="orbital-canvas" data-orbital-canvas></div>
</div>

<script>
  import * as THREE from 'three';
  import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

  // A continuous, machined ribbon: one form, with a warm illuminated seam.
  class OrbitalPath extends THREE.Curve<THREE.Vector3> {
    getPoint(t: number, target = new THREE.Vector3()) {
      const angle = t * Math.PI * 2;
      const radius = 1.72 + 0.5 * Math.cos(angle * 3);
      return target.set(
        radius * Math.cos(angle * 2),
        radius * Math.sin(angle * 2),
        0.64 * Math.sin(angle * 3),
      );
    }
  }

  function mountOrbital(stage: HTMLElement) {
    const container = stage.querySelector<HTMLElement>('[data-orbital-canvas]');
    if (!container || container.childElementCount) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'low-power' });
    } catch {
      // The CSS halo remains when WebGL is unavailable.
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setClearColor(0x09090b, 0);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    container.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(39, 1, 0.1, 40);
    camera.position.set(0, 0, 9.8);

    const environment = new RoomEnvironment();
    const pmrem = new THREE.PMREMGenerator(renderer);
    const environmentMap = pmrem.fromScene(environment, 0.04);
    scene.environment = environmentMap.texture;
    environment.dispose();
    pmrem.dispose();

    const sculpture = new THREE.Group();
    scene.add(sculpture);
    const path = new OrbitalPath();
    const segments = window.innerWidth < 768 ? 180 : 320;
    const frames = path.computeFrenetFrames(segments, true);
    const positions: number[] = [];
    const indices: number[] = [];
    // Beveled rectangular section gives the ribbon broad faces and precise edges.
    const section = [
      [-0.23, -0.035], [-0.205, -0.06], [0.205, -0.06], [0.23, -0.035],
      [0.23, 0.035], [0.205, 0.06], [-0.205, 0.06], [-0.23, 0.035],
    ];
    const seams = [[], []] as THREE.Vector3[][];
    const point = new THREE.Vector3();
    const normal = new THREE.Vector3();
    const binormal = new THREE.Vector3();

    for (let i = 0; i <= segments; i++) {
      const t = i / segments;
      path.getPoint(t, point);
      // A complete twist closes seamlessly and catches the light as it turns.
      const twist = t * Math.PI * 2;
      normal.copy(frames.normals[i]).multiplyScalar(Math.cos(twist))
        .addScaledVector(frames.binormals[i], Math.sin(twist));
      binormal.copy(frames.binormals[i]).multiplyScalar(Math.cos(twist))
        .addScaledVector(frames.normals[i], -Math.sin(twist));
      for (const [width, depth] of section) {
        positions.push(
          point.x + normal.x * width + binormal.x * depth,
          point.y + normal.y * width + binormal.y * depth,
          point.z + normal.z * width + binormal.z * depth,
        );
      }
      for (let side = 0; side < 2; side++) {
        seams[side].push(point.clone().addScaledVector(normal, side ? 0.218 : -0.218)
          .addScaledVector(binormal, 0.048));
      }
      if (i < segments) {
        for (let j = 0; j < section.length; j++) {
          const a = i * section.length + j;
          const b = i * section.length + (j + 1) % section.length;
          const c = a + section.length;
          const d = b + section.length;
          indices.push(a, b, c, b, d, c);
        }
      }
    }

    const ribbonGeometry = new THREE.BufferGeometry();
    ribbonGeometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
    ribbonGeometry.setIndex(indices);
    ribbonGeometry.computeVertexNormals();
    const titanium = new THREE.MeshStandardMaterial({
      color: 0x44434a, metalness: 0.92, roughness: 0.27, side: THREE.DoubleSide,
    });
    sculpture.add(new THREE.Mesh(ribbonGeometry, titanium));

    const copper = new THREE.MeshStandardMaterial({
      color: 0xff792f, metalness: 0.68, roughness: 0.3,
      emissive: 0xee490c, emissiveIntensity: 0.65,
    });
    const seamGeometries = seams.map((points) => new THREE.TubeGeometry(
      new THREE.CatmullRomCurve3(points, true), segments, 0.013, 5, true,
    ));
    seamGeometries.forEach((geometry) => sculpture.add(new THREE.Mesh(geometry, copper)));

    const keyLight = new THREE.DirectionalLight(0xffe2c4, 4);
    keyLight.position.set(-3, 5, 5);
    scene.add(keyLight);
    const rimLight = new THREE.PointLight(0xff611f, 28, 14, 2);
    rimLight.position.set(3, -1, 2);
    scene.add(rimLight);
    const fillLight = new THREE.DirectionalLight(0xb9c4da, 1.8);
    fillLight.position.set(-4, -2, 1);
    scene.add(fillLight);

    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = new THREE.Vector2();
    const smoothedPointer = new THREE.Vector2();
    let frame = 0;
    let visible = false;
    let disposed = false;
    let elapsed = 0;
    let previousTime = 0;

    function render(time: number) {
      frame = 0;
      if (disposed) return;
      const delta = previousTime ? Math.min((time - previousTime) / 1000, 0.05) : 0;
      previousTime = time;
      if (!motion.matches) elapsed += delta;
      if (motion.matches) smoothedPointer.set(0, 0);
      else smoothedPointer.lerp(pointer, 0.035);
      sculpture.rotation.set(
        0.28 + Math.sin(elapsed * 0.18) * 0.12 + smoothedPointer.y * 0.12,
        -0.36 + Math.sin(elapsed * 0.12) * 0.24 + smoothedPointer.x * 0.18,
        -0.24 + elapsed * 0.035,
      );
      renderer.render(scene, camera);
      if (visible && !document.hidden && !motion.matches) frame = requestAnimationFrame(render);
    }

    function requestRender() {
      if (!frame && !disposed && visible && !document.hidden) {
        previousTime = 0;
        frame = requestAnimationFrame(render);
      }
    }

    function resize() {
      const { width, height } = container.getBoundingClientRect();
      if (!width || !height) return;
      renderer.setSize(width, height);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      const mobile = width < 768;
      sculpture.scale.setScalar(mobile ? 0.73 : 1.05);
      sculpture.position.set(mobile ? 0.1 : 0.5, mobile ? 0.7 : -0.15, 0);
      requestRender();
    }

    function onPointer(event: PointerEvent) {
      const rect = stage.getBoundingClientRect();
      pointer.set(
        THREE.MathUtils.clamp((event.clientX - rect.left) / rect.width * 2 - 1, -1, 1),
        THREE.MathUtils.clamp((event.clientY - rect.top) / rect.height * 2 - 1, -1, 1),
      );
    }

    function updatePlayback() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      requestRender();
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(container);
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updatePlayback();
    });
    intersectionObserver.observe(stage);
    window.addEventListener('pointermove', onPointer, { passive: true });
    document.addEventListener('visibilitychange', updatePlayback);
    motion.addEventListener('change', updatePlayback);
    resize();

    function dispose() {
      disposed = true;
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      window.removeEventListener('pointermove', onPointer);
      document.removeEventListener('visibilitychange', updatePlayback);
      motion.removeEventListener('change', updatePlayback);
      document.removeEventListener('astro:before-swap', dispose);
      window.removeEventListener('pagehide', onPageHide);
      window.removeEventListener('pageshow', updatePlayback);
      ribbonGeometry.dispose();
      seamGeometries.forEach((geometry) => geometry.dispose());
      titanium.dispose();
      copper.dispose();
      environmentMap.dispose();
      renderer.dispose();
      renderer.domElement.remove();
    }
    function onPageHide(event: PageTransitionEvent) {
      if (!event.persisted) dispose();
    }
    document.addEventListener('astro:before-swap', dispose, { once: true });
    window.addEventListener('pagehide', onPageHide);
    window.addEventListener('pageshow', updatePlayback);
  }

  function initOrbital() {
    document.querySelectorAll<HTMLElement>('[data-orbital-stage]').forEach(mountOrbital);
  }
  initOrbital();
  document.addEventListener('astro:page-load', initOrbital);
</script>

<style>
  .orbital-stage {
    overflow: hidden;
    contain: layout paint;
  }
  .orbital-halo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 55% 54%, rgb(234 88 12 / 0.08), transparent 53%),
      radial-gradient(ellipse at 46% 43%, rgb(148 163 184 / 0.035), transparent 48%);
  }
  .orbital-canvas {
    position: absolute;
    inset: 0;
    opacity: 0.85;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 84%, transparent);
  }
  .orbital-canvas :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 767px) {
    .orbital-canvas { opacity: 0.62; }
  }
</style>
