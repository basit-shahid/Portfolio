---
// Premium Decoder Preloader
---

<script is:inline>
  if (typeof window !== "undefined" && !sessionStorage.getItem('portfolio_booted')) {
    const style = document.createElement('style');
    style.id = 'loader-scroll-lock';
    style.innerHTML = 'html, body { overflow: hidden !important; } #timeline-scroll { display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; }';
    document.head.appendChild(style);
  }
</script>

<div id="loader-wrapper" class="fixed inset-0 z-[100] bg-zinc-950 flex flex-col justify-center items-center transition-transform duration-[0.8s] cubic-bezier(0.16, 1, 0.3, 1) font-mono">
  
  <div class="flex flex-col items-center">
    <!-- Small label -->
    <div class="text-zinc-500 text-xs sm:text-sm tracking-[0.3em] uppercase mb-8 opacity-0 animate-fade-in text-center" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
      Decrypting Author Identity
    </div>
    
    <!-- Blocks container -->
    <div id="name-container" class="flex flex-wrap justify-center gap-y-3 sm:gap-y-4 px-4 max-w-[95vw]">
      <!-- JS injected blocks -->
    </div>

    <!-- Progress bar -->
    <div class="w-48 sm:w-64 h-1 bg-zinc-800 mt-12 rounded-full overflow-hidden opacity-0 animate-fade-in" style="animation-delay: 0.4s; animation-fill-mode: forwards;">
      <div id="loader-progress" class="h-full bg-orange-500 w-0 transition-all duration-[75ms]"></div>
    </div>
  </div>

  <!-- Hidden div to ensure Tailwind includes dynamic classes -->
  <div class="hidden bg-orange-500/10 border-orange-500 text-orange-500 shadow-[0_0_15px_rgba(249,115,22,0.3)] bg-zinc-900 border-zinc-700/50 text-zinc-500 text-white bg-orange-500 text-zinc-950 w-7 h-10 sm:w-10 sm:h-14 md:w-12 md:h-16 gap-1 md:gap-2 w-3 sm:w-6 transition-colors duration-300"></div>
</div>

<script>
  if (typeof window !== "undefined") {
    if (sessionStorage.getItem('portfolio_booted')) {
      const loader = document.getElementById('loader-wrapper');
      if (loader) {
         loader.style.display = 'none';
      }
    } else {
      if (!document.getElementById('loader-scroll-lock')) {
         const style = document.createElement('style');
         style.id = 'loader-scroll-lock';
         style.innerHTML = 'html, body { overflow: hidden !important; } #timeline-scroll { display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; }';
         document.head.appendChild(style);
      }
      
      document.addEventListener("DOMContentLoaded", () => {
        const wrapper = document.getElementById('loader-wrapper');
        const container = document.getElementById('name-container');
        const progressBar = document.getElementById('loader-progress');

        const target = "ABDUL BASIT SHAHID";
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*+";
        
        const blocks = [];
        let totalBlocks = 0;

        const words = target.split(' ');
        
        words.forEach((word, wordIdx) => {
          const wordDiv = document.createElement('div');
          wordDiv.className = 'flex gap-1 md:gap-2';
          
          for(let i = 0; i < word.length; i++) {
            const block = document.createElement('div');
            // Responsive block sizes
            block.className = 'w-7 h-10 sm:w-10 sm:h-14 md:w-12 md:h-16 bg-zinc-900 border border-zinc-700/50 flex items-center justify-center text-zinc-500 font-bold text-lg sm:text-2xl md:text-3xl relative overflow-hidden transition-colors duration-300';
            
            const span = document.createElement('span');
            span.innerText = chars[Math.floor(Math.random() * chars.length)];
            block.appendChild(span);
            
            wordDiv.appendChild(block);
            blocks.push({ element: block, span: span, targetChar: word[i], resolved: false });
            totalBlocks++;
          }
          
          container.appendChild(wordDiv);
          
          if (wordIdx < words.length - 1) {
            const space = document.createElement('div');
            space.className = 'w-3 sm:w-6';
            container.appendChild(space);
          }
        });

        let iterations = 0;
        let resolvedCount = 0;

        const interval = setInterval(() => {
          let allDone = true;
          
          blocks.forEach((block, index) => {
            if (block.resolved) return;

            // Introduce staggered resolution
            const resolveThreshold = 15 + (index * 2) + Math.random() * 15;
            
            if (iterations > resolveThreshold) {
              block.span.innerText = block.targetChar;
              block.element.classList.remove('bg-zinc-900', 'border-zinc-700/50', 'text-zinc-500');
              block.element.classList.add('bg-orange-500/10', 'border-orange-500', 'text-orange-500', 'shadow-[0_0_15px_rgba(249,115,22,0.3)]');
              
              // Flash white briefly
              block.span.classList.add('text-white');
              setTimeout(() => {
                block.span.classList.remove('text-white');
              }, 150);
              
              block.resolved = true;
              resolvedCount++;
            } else {
              if (iterations % 2 === 0) {
                 block.span.innerText = chars[Math.floor(Math.random() * chars.length)];
              }
              allDone = false;
            }
          });

          if (progressBar) {
            progressBar.style.width = `${(resolvedCount / totalBlocks) * 100}%`;
          }

          iterations++;

          if (allDone) {
            clearInterval(interval);
            
            // Final sequence flash for all
            setTimeout(() => {
              blocks.forEach(b => {
                b.element.classList.add('bg-orange-500', 'text-zinc-950');
                b.element.classList.remove('text-orange-500', 'bg-orange-500/10', 'border-orange-500', 'shadow-[0_0_15px_rgba(249,115,22,0.3)]');
              });
            }, 600);

            // Exit animation
            setTimeout(() => {
               if (wrapper) wrapper.style.transform = 'translateY(-100%)';
               const lock = document.getElementById('loader-scroll-lock');
               if (lock) lock.remove();
               document.body.style.overflow = ''; 
               document.documentElement.style.overflow = '';
               sessionStorage.setItem('portfolio_booted', 'true');
            }, 1400);
          }
        }, 40);

      });
    }
  }
</script>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>
