          "author": { "@type": "Person", "name": "Abdul Basit Shahid" }
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "SoftwareSourceCode",
          "name": "TurboDM",
          "description": "A high-performance, professional-grade Download Manager for Windows with a sleek neon-inspired UI and a powerful multi-threaded core capable of accelerating downloads with up to 32 parallel connections.",
          "programmingLanguage": "JavaScript / Electron / Node.js",
          "codeRepository": "https://github.com/basit-shahid/turbodm",
          "author": { "@type": "Person", "name": "Abdul Basit Shahid" }
