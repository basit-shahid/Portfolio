---
import "@/styles/global.css";
import { getImage } from "astro:assets";
import IDImg from "../assets/abdul-basit-shahid-software-engineer.png";

const optimizedLCP = await getImage({ src: IDImg, format: "webp" });

// SEO Configuration
const title = "Abdul Basit Shahid — Full-Stack Developer & Backend Engineer | Portfolio";
const description = "Abdul Basit Shahid is a Full-Stack Developer and Backend Engineer from Lahore, Pakistan, studying Software Engineering at COMSATS University. Specializing in Laravel, Node.js, TypeScript, and scalable backend systems. Explore projects, skills, and professional portfolio.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/abdul-basit-shahid-software-engineer.png", Astro.site);
const siteUrl = "https://abdulbasitshahid.vercel.app";
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Abdul Basit Shahid" />
<meta name="keywords" content="Abdul Basit Shahid, Abdul Basit, Basit Shahid, Abdul Basit developer, Abdul Basit Shahid portfolio, Abdul Basit Shahid software engineer, Full-Stack Developer, Backend Engineer, Laravel Developer, Node.js Developer, Software Engineer Pakistan, COMSATS Lahore, Web Developer Lahore, PHP Developer, API Architecture, Electron Developer, TypeScript Developer, PostgreSQL, React Developer, Abdul Basit COMSATS, basit-shahid GitHub" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="subject" content="Abdul Basit Shahid — Software Engineer Portfolio" />
<meta name="classification" content="Portfolio, Software Engineering, Web Development" />
<meta name="rating" content="General" />
<meta name="revisit-after" content="3 days" />
<link rel="canonical" href={canonicalURL} />

<!-- Social Profile Links (rel=me) -->
<link rel="me" href="https://github.com/basit-shahid" />
<link rel="me" href="https://www.instagram.com/abdulbasit_shahid" />
<link rel="me" href="mailto:basitdogar59@gmail.com" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="profile" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Abdul Basit Shahid — Full-Stack Developer and Backend Engineer" />
<meta property="og:site_name" content="Abdul Basit Shahid — Portfolio" />
<meta property="og:locale" content="en_US" />
<meta property="profile:first_name" content="Abdul Basit" />
<meta property="profile:last_name" content="Shahid" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta property="twitter:image:alt" content="Abdul Basit Shahid — Full-Stack Developer and Backend Engineer" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="mask-icon" href="/favicon.svg" color="#f97316" />
<meta name="msapplication-TileColor" content="#000000" />
<meta name="theme-color" content="#000000" />

<!-- Preload LCP Image -->
<link rel="preload" as="image" href={optimizedLCP.src} fetchpriority="high" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
  rel="stylesheet"
/>

<!-- Keen Slider -->
<link
  href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css"
  rel="stylesheet"
  integrity="sha384-c33HE1mLXmDEd7Ir2k6bCPjErFY+gVW8y6h8x7HN5BHlqc7KFbvhXd8uO5eTPcVZ"
  crossorigin="anonymous"
/>

<!-- Alpine.js (pinned version with SRI) -->
<script
  defer
  src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"
  integrity="sha384-9Ax3MmS9AClxJyd5/zafcXXjxmwFhZCdsT6HJoJjarvCaAkJlk5QDzjLJm+Wdx5F"
  crossorigin="anonymous"
></script>

<!-- JSON-LD Structured Data: WebSite + ProfilePage + Person + FAQ + ItemList -->
<script type="application/ld+json" set:html={JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Abdul Basit Shahid — Portfolio",
    "alternateName": ["Abdul Basit Shahid", "Basit Shahid", "Abdul Basit"],
    "url": siteUrl,
    "description": description,
    "inLanguage": "en-US",
