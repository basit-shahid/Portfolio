    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Lahore",
      "addressRegion": "Punjab",
      "addressCountry": "PK"
    },
    "email": "basitdogar59@gmail.com",
    "sameAs": [
      "https://github.com/basit-shahid",
      "https://www.instagram.com/abdulbasit_shahid"
    ],
    "makesOffer": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Full-Stack Web Development",
          "description": "End-to-end web application development using Laravel, Node.js, React, and modern frameworks"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Backend Engineering & API Architecture",
          "description": "Scalable backend systems, RESTful API design, database optimization, and server-side logic"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desktop Application Development",
          "description": "Cross-platform desktop applications built with Electron.js and Node.js"
        }
      }
    ],
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".sr-only", "meta[name='description']"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who is Abdul Basit Shahid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Abdul Basit Shahid is a Full-Stack Developer and Backend Engineer based in Lahore, Pakistan. He is currently studying Software Engineering at COMSATS University Islamabad, Lahore Campus (Spring 2025 batch). He specializes in building robust web applications, scalable backend systems, and developer tools using modern technologies like Laravel, Node.js, TypeScript, and PostgreSQL."
        }
      },
      {
        "@type": "Question",
        "name": "What is Abdul Basit Shahid's tech stack?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Abdul Basit Shahid's core tech stack includes: Backend — Laravel, PHP, Node.js, Express.js, TypeScript; Frontend — React, Next.js, Astro, Tailwind CSS; Databases — PostgreSQL, MySQL; Desktop — Electron.js; DevOps — Docker, Git. He excels in API Architecture, Backend Engineering, and Full-Stack Web Development."
        }
      },
      {
        "@type": "Question",
        "name": "Where does Abdul Basit Shahid study?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Abdul Basit Shahid studies Software Engineering at COMSATS University Islamabad, Lahore Campus. He is part of the Spring 2025 batch and focuses on Data Structures & Algorithms, Object-Oriented Design, and Full-Stack Web Development alongside his academic curriculum."
        }
      },
      {
        "@type": "Question",
        "name": "What projects has Abdul Basit Shahid built?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Abdul Basit Shahid has built several notable projects: 1) FastFood Invoice System — a full-stack Laravel-based invoice management system with role-based access control and Docker deployment; 2) Drop — a minimal, blazing-fast drag-and-drop file utility built with Electron.js; 3) TurboDM — a high-performance download manager for Windows with multi-threaded downloading supporting up to 32 parallel connections. All projects are available on his GitHub at github.com/basit-shahid."
        }
      },
      {
        "@type": "Question",
        "name": "How can I contact Abdul Basit Shahid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can contact Abdul Basit Shahid via email at basitdogar59@gmail.com. You can also find him on GitHub (github.com/basit-shahid) and Instagram (@abdulbasit_shahid). His portfolio website is available at abdulbasitshahid.vercel.app."
        }
      },
      {
        "@type": "Question",
        "name": "Where is Abdul Basit Shahid located?",
        "acceptedAnswer": {
          "@type": "Answer",
