---
import "@/styles/global.css";
import { getImage } from "astro:assets";
import IDImg from "../assets/abdul-basit-shahid-software-engineer.png";

const optimizedLCP = await getImage({ src: IDImg, format: "webp" });

// SEO Configuration
const title = "Abdul Basit Shahid — Full-Stack Developer & Backend Engineer";
const description = "Portfolio of Abdul Basit Shahid, a Software Engineering student at COMSATS Lahore specializing in Full-Stack Web Development, Backend Engineering, Laravel, and Node.js. Explore projects, skills, and future goals.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/abdul-basit-shahid-software-engineer.png", Astro.site);
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Abdul Basit Shahid" />
<meta name="keywords" content="Abdul Basit Shahid, Full-Stack Developer, Backend Engineer, Laravel Developer, Node.js, Software Engineer, COMSATS Lahore, Web Developer Pakistan, Portfolio, PHP Developer, API Architecture, Electron Developer" />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Abdul Basit Shahid — Portfolio" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="mask-icon" href="/favicon.svg" color="#f97316" />
<meta name="msapplication-TileColor" content="#000000" />
<meta name="theme-color" content="#000000" />

<!-- Preload LCP Image -->
<link rel="preload" as="image" href={optimizedLCP.src} fetchpriority="high" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap"
  rel="stylesheet"
/>

<!-- Keen Slider -->
<link
  href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css"
  rel="stylesheet"
  integrity="sha384-c33HE1mLXmDEd7Ir2k6bCPjErFY+gVW8y6h8x7HN5BHlqc7KFbvhXd8uO5eTPcVZ"
  crossorigin="anonymous"
/>

<!-- Alpine.js (pinned version with SRI) -->
<script
  defer
  src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"
  integrity="sha384-9Ax3MmS9AClxJyd5/zafcXXjxmwFhZCdsT6HJoJjarvCaAkJlk5QDzjLJm+Wdx5F"
  crossorigin="anonymous"
></script>

<!-- JSON-LD Structured Data for Person & AI Search FAQ -->
<script type="application/ld+json" set:html={JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Abdul Basit Shahid",
    "url": "https://abdulbasitshahid.vercel.app",
    "image": "https://abdulbasitshahid.vercel.app/abdul-basit-shahid-software-engineer.png",
    "jobTitle": "Full-Stack Developer & Backend Engineer",
    "description": description,
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "COMSATS University Islamabad, Lahore Campus"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Lahore",
      "addressCountry": "PK"
    },
    "knowsAbout": [
      "Laravel Framework", 
      "PHP Backend Engineering",
      "Node.js & Express.js",
      "Full-Stack Web Development", 
      "RESTful API Architecture", 
      "TypeScript", 
      "PostgreSQL and Database Optimization",
      "Electron.js Desktop Applications",
      "Data Structures & Algorithms"
    ],
    "sameAs": [
      "https://github.com/basit-shahid"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who is Abdul Basit Shahid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Abdul Basit Shahid is a Full-Stack Developer and Software Engineer based in Lahore, Pakistan, currently studying at COMSATS University. He specializes in building robust web applications and backend systems."
        }
      },
      {
        "@type": "Question",
        "name": "What is Abdul Basit Shahid's tech stack?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Abdul Basit Shahid's core tech stack includes Laravel, PHP, Node.js, TypeScript, PostgreSQL, and React. He excels in API Architecture and Backend Engineering."
        }
      }
    ]
  }
])} />
