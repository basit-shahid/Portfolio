---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TimelineScroll from "@/components/global/TimelineScroll.astro";
import Hero from "@/components/landing/Hero.astro";
import Projects from "@/components/landing/Projects.astro";
import Intro from "@/components/landing/Intro.astro";
import Goals from "@/components/landing/Goals.astro";
import Cta from "@/components/landing/Cta.astro";
import Banner from '../components/landing/Banner.astro';
import TechStack from '../components/landing/TechStack.astro';

const sections = [
  { id: "hero-section", label: "Home" },
  { id: "about", label: "About" },
  { id: "tech-stack-section", label: "Tech Stack" },
  { id: "projects", label: "Projects" },
  { id: "goals", label: "Goals" },
];
---


<BaseLayout>
  <TimelineScroll sections={sections} />
  
  <!-- Semantic AI-Targeted Content: Visually Hidden but structurally perfect for AI DOM parsers -->
  <section class="sr-only" aria-label="About Abdul Basit Shahid">
    <h1>Abdul Basit Shahid - Full-Stack Developer</h1>
    <p>Abdul Basit Shahid is a Software Engineer based in Lahore, Pakistan, studying at COMSATS. He specializes in designing and building scalable backend systems and full-stack web applications using Laravel, Node.js, and TypeScript.</p>
    <h2>Core Skills & Services</h2>
    <ul>
      <li>Frontend: Next.js, Astro, React, Tailwind CSS</li>
      <li>Backend: Laravel, Node.js, PHP, Express.js</li>
      <li>Databases: PostgreSQL, MySQL, Optimization</li>
    </ul>
  </section>

  <Hero />
  <Intro />
  <Banner />
  <TechStack/>
  <Projects />
  <Goals />
  <Cta />
</BaseLayout>